# 是否啟用 keep-awake。未設定時預設為 1。
KEEP_AWAKE_ENABLED=1

# 守護進程檢查 Herdr agent 狀態的頻率（秒）。預設為 15。
KEEP_AWAKE_POLL_INTERVAL=15

# 當 agent 處於工作狀態時是否同時保持螢幕開啟。
# 設為 0 僅防止系統休眠（節省電量）。預設為 1。
KEEP_AWAKE_DISPLAY=1

# 是否啟用 OpenCode 多 session 追蹤。預設為 1。
OPENCODE_KEEP_AWAKE_ENABLED=1

# OpenCode 行程心跳逾時時間（秒）。逾期心跳將在此時間後被判定為過期並忽略（不主動刪除狀態檔）。預設為 30。
OPENCODE_HEARTBEAT_TIMEOUT=30

# 選填：OpenCode 狀態檔的明確共用目錄。預設為 ~/.local/state/herdr-keep-awake/opencode。
# OPENCODE_STATE_DIR=/path/to/shared/opencode

# 呼叫 herdr CLI 的執行逾時上限（毫秒）。預設為 5000。
HERDR_TIMEOUT_MS=5000
