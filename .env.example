# Enable keep-awake. Default: 1.
KEEP_AWAKE_ENABLED=1

# Daemon polling interval in seconds. Default: 15.
KEEP_AWAKE_POLL_INTERVAL=15

# Keep the display on while working. Set 0 to save battery. Default: 1.
KEEP_AWAKE_DISPLAY=1

# Enable OpenCode snapshot tracking. Default: 1.
OPENCODE_KEEP_AWAKE_ENABLED=1

# Ignore older process heartbeats without deleting files, in seconds. Default: 30.
OPENCODE_HEARTBEAT_TIMEOUT=30

# Optional shared snapshot directory; export for both Herdr and OpenCode.
# OPENCODE_STATE_DIR=/path/to/shared/opencode

# Herdr CLI timeout in milliseconds. Default: 5000.
HERDR_TIMEOUT_MS=5000
