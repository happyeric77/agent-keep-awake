# Whether keep-awake should run at all. Defaults to 1 when unset.
KEEP_AWAKE_ENABLED=1

# How often (seconds) the daemon checks Herdr agent status. Defaults to 15.
KEEP_AWAKE_POLL_INTERVAL=15

# Whether the display should stay on too while an agent is working.
# Set to 0 to only prevent system sleep (saves battery). Defaults to 1.
KEEP_AWAKE_DISPLAY=1

# Whether OpenCode multi-session tracking is enabled. Defaults to 1.
OPENCODE_KEEP_AWAKE_ENABLED=1

# OpenCode process heartbeat timeout in seconds. Stale processes are cleaned up after this. Defaults to 30.
OPENCODE_HEARTBEAT_TIMEOUT=30

# Optional explicit directory for OpenCode state files. Defaults to ~/.local/state/herdr-keep-awake/opencode.
# OPENCODE_STATE_DIR=/path/to/shared/opencode

# Bounded execution timeout in milliseconds for herdr CLI calls. Defaults to 5000.
HERDR_TIMEOUT_MS=5000
